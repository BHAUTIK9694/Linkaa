# =============================================================================
# Livantaa — Environment Variables
# =============================================================================
# Copy this file to .env.development for local XAMPP development.
# Copy to .env.production (or set in your hosting panel) for production.
#
# .env.development  — loaded by Vite when running `npm run dev`
# .env.production   — loaded by Vite when running `npm run build`
# Both are intentionally in .gitignore — never commit real values.
# =============================================================================

# ---------------------------------------------------------------------------
# API base URL
# ---------------------------------------------------------------------------
# The URL prefix for ALL backend API calls.
# Must NOT have a trailing slash.
#
# Local XAMPP (project lives at htdocs/Linkaa):
#   VITE_API_BASE_URL=http://localhost/Linkaa/api
#
# Production (custom domain, API at /api):
#   VITE_API_BASE_URL=https://yourdomain.com/api
#
# Vite dev-server proxy (recommended for local dev — avoids CORS issues):
#   VITE_API_BASE_URL=/Linkaa/api
#   (Vite will proxy /Linkaa/api/* → http://localhost/Linkaa/api/*)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost/Linkaa/api

# ---------------------------------------------------------------------------
# PHP backend and Hostinger SMTP
# ---------------------------------------------------------------------------
APP_ENV=production
APP_URL=https://livantaa.com
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@livantaa.com
MAIL_PASSWORD=replace-with-your-hostinger-mailbox-password
MAIL_FROM=info@livantaa.com
MAIL_FROM_NAME=Livantaa
MAIL_ADMIN_TO=parthmovaliya8304@gmail.com
# Optional local testing override: both contact emails go here when populated.
MAIL_TEST_RECIPIENT=
